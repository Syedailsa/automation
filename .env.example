# NotebookLM Playwright Agent Configuration

# Paths
NOTEBOOKLM_HOME=~/.notebooklm

# Browser settings
HEADLESS=false
SLOW_MO=0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Timeouts (in milliseconds)
NAVIGATION_TIMEOUT=60000
ACTION_TIMEOUT=30000
LOGIN_TIMEOUT=300000

# Rate limiting
MAX_REQUESTS_PER_MINUTE=10

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=1.0
RETRY_BACKOFF=2.0

# Human-like delays (in seconds)
MIN_TYPING_DELAY=0.05
MAX_TYPING_DELAY=0.15
MIN_CLICK_DELAY=0.5
MAX_CLICK_DELAY=1.5

# Logging
LOG_LEVEL=INFO
