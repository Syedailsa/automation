{
  "info": {
    "name": "NotebookLM Portal API",
    "description": "Integration tests for the NotebookLM Portal Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "notebook_id",
      "value": ""
    },
    {
      "key": "source_id",
      "value": ""
    },
    {
      "key": "output_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is ok', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Google Redirect",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/google/redirect"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns authorization URL', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().authorization_url).to.include('accounts.google.com');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Google Callback (Invalid Code)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/google/callback",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"code\": \"invalid_code\", \"state\": \"test_state\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 400 for invalid code', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me (Unauthorized)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (Unauthorized)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Notebooks",
      "item": [
        {
          "name": "List Notebooks (Unauthorized)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/notebooks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Notebook (Unauthorized)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/notebooks",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Test Notebook\", \"description\": \"Created via Postman\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Notebook (Invalid UUID)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/notebooks/not-a-uuid"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 422 for invalid UUID', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 422]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sources",
      "item": [
        {
          "name": "Add URL Source (Unauthorized)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/notebooks/00000000-0000-0000-0000-000000000000/sources/url",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Test Source\", \"url\": \"https://example.com\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Text Source (Unauthorized)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/notebooks/00000000-0000-0000-0000-000000000000/sources/text",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Test Text Source\", \"content\": \"Sample text content\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Outputs",
      "item": [
        {
          "name": "Delete Output (Unauthorized)",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/outputs/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Agent",
      "item": [
        {
          "name": "Refine Input (Unauthorized)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/agent/refine",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"input_text\": \"Hello world\", \"language\": \"en\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Execute Workflow (Unauthorized)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/agent/execute",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"input_text\": \"Test workflow\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Status (Unauthorized)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/agent/status/test-execution-id"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get History (Unauthorized)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/agent/history"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
