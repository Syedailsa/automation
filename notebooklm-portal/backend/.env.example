# Application
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://notebooklm:notebooklm_secret@localhost:5432/notebooklm_portal

# JWT
JWT_SECRET_KEY=change-me-to-random-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://novaai.8.jugaar.ai/auth/callback

# LLM Keys
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
OPENROUTER_API_KEY=sk-or-v1-xxx
FIREWORKS_API_KEY=fw-xxx

# LLM Settings
LLM_DEFAULT_PROVIDER=openrouter
LLM_DEFAULT_MODEL=qwen/qwen3.7-max
LLM_FALLBACK_PROVIDERS=openai,anthropic,ollama
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# Redis
REDIS_URL=redis://localhost:6379/0

# Database Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Rate Limit Tiers (requests per hour, 0 = unlimited)
RATE_LIMIT_FREE=50
RATE_LIMIT_PRO=200
RATE_LIMIT_ADMIN=0

# Storage
NOTEBOOKLM_STORAGE_BASE=storage/

# Upload limits
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,txt,md,docx,csv,json

# CORS
CORS_ORIGINS=https://novaai.8.jugaar.ai,http://localhost:80
